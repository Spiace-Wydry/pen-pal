# Values from `npx supabase status -o env` (API_URL, ANON_KEY, SERVICE_ROLE_KEY).
# For phones on the same Wi-Fi, use the laptop's LAN IP instead of 127.0.0.1.
# API port is 54421 (not the default 54321) because supabase/config.toml shifts ports by +100.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
# Code required by /admin/skan (PiszuPunkt scan simulator)
NUXT_ADMIN_CODE=skan-demo
